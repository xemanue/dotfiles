{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 16,
    "mode": "dock",
    "reload_style_on_change": true,

    "modules-left": [
        "hyprland/workspaces"
    ],
    "modules-right": [
        "network",
        "custom/separator",
        "group/pulseaudio",
        "custom/separator",
        "clock",
        "custom/separator",
        "custom/power"
    ],

    "include": [
        "~/.config/waybar/modules/custom/separator.jsonc",
        "~/.config/waybar/modules/custom/power.jsonc",
        "~/.config/waybar/modules/hyprland/workspaces.jsonc",
        "~/.config/waybar/modules/pulseaudio.jsonc",
        "~/.config/waybar/modules/network.jsonc",
        "~/.config/waybar/modules/clock.jsonc"
    ]
}
