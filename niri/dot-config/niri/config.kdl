// █▀▀ ▀▄▀ █▀▀ █▀▀ █▀ //
// ██▄ █ █ ██▄ █▄▄ ▄█ //

spawn-at-startup "waybar"
spawn-at-startup "awww-daemon"
spawn-at-startup "/usr/lib/soteria-polkit/soteria"


input {
    mod-key "Super"

    keyboard {
        xkb {
            layout "us"
            variant "altgr-intl"
            options "caps:escape"
        }

        repeat-delay 200
        repeat-rate 25
    }

    mouse {
        accel-profile "flat"
    }

    touchpad {
        tap
        natural-scroll
        scroll-factor 0.25
    }

    focus-follows-mouse
    disable-power-key-handling
}

output "DP-3" {
    mode "1920x1080@165"
    scale 1
    transform "normal"
    position x=0 y=0
}

layout {
    gaps 8

    struts {
        left 8
        right 8
        top 8
        bottom 8
    }

    center-focused-column "never" // Va duro de cojones ponerlo a "always"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        off

        width 2

        active-color "#e78a4e"
        // active-gradient from="#e78a4e" to="#d8a657" angle=45
        // inactive-gradient from="#7c6f64" to="#928374" angle=45 relative-to="workspace-view"
    }

    border {
      on

      width 1

      active-color "#ff8080"
      inactive-color "#2a2a32"
    }

    tab-indicator {
      width 4
      length total-proportion=0.25
      place-within-column

      gap 8 // if using focus-ring, gap - focus-ring = actual gap
      gaps-between-tabs 4
    }

    shadow {
        on
        softness 5
        spread 5
        offset x=0 y=0
        color "#0005"
    }
}

overview {
    backdrop-color "#181818"
}
 
gestures {
    hot-corners {
        off
    }
}

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd

// You can change the path where screenshots are saved.
// A ~ at the front will be expanded to the home directory.
// The path is formatted with strftime(3) to give you the screenshot date and time.
screenshot-path "~/pictures/screenshots/screenshot_%Y-%m-%d %H-%M-%S.png"

// You can also set this to null to disable saving screenshots to disk.
// screenshot-path null

// Animation settings.
// The wiki explains how to configure individual animations:
// https://yalter.github.io/niri/Configuration:-Animations
animations {
    // Uncomment to turn off all animations.
    // off

    // Slow down all animations by this factor. Values below 1 speed them up instead.
    // slowdown 3.0
}

// Work around WezTerm's initial configure bug
// by setting an empty default-column-width.
window-rule {
    // This regular expression is intentionally made as specific as possible,
    // since this is the default config, and we want no false positives.
    // You can get away with just app-id="wezterm" if you want.
    match app-id=r#"^org\.wezfurlong\.wezterm$"#
    default-column-width { }
}

// Thunar rename
window-rule {
    match app-id="Thunar" title="Rename.*"

    open-floating true
    default-column-width { fixed 360; }
    default-window-height { fixed 120; }
}

window-rule {
    match app-id="thunar" title="Rename.*"

    open-floating true
    default-column-width { fixed 360; }
    default-window-height { fixed 120; }
}

// Polkit window
window-rule {
    match app-id="xfce-polkit"

    open-floating true
    default-column-width { fixed 480; }
    default-window-height { fixed 240; }
}

// PiP
window-rule {
    match app-id="" title="^Picture in picture$"

    open-floating true
    default-column-width { fixed 384; }
    default-window-height { fixed 216; }
    default-floating-position x=16 y=16 relative-to="bottom-right"
}


binds {
    Mod+Shift+P { spawn-sh "killall -SIGUSR2 waybar"; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Suggested binds for running programs: terminal, app launcher, screen locker.
    Mod+Return hotkey-overlay-title="Open WezTerm" { spawn "wezterm"; }

    Mod+D hotkey-overlay-title="Open Rofi" {
        spawn-sh "rofi -show drun -config '.config/rofi/config.rasi' -theme '.config/rofi/styles/dmenu.rasi'";
    }

    // Keyboard volume control
    XF86AudioRaiseVolume allow-when-locked=true {
        spawn-sh "./.local/bin/volume.sh output raise";
    }
    XF86AudioLowerVolume allow-when-locked=true {
        spawn-sh "./.local/bin/volume.sh output lower";
    }

    Mod+Tab repeat=false { toggle-overview; }
    Mod+Q repeat=false { close-window; }

    Mod+H { focus-column-left; }
    Mod+J { focus-window-or-workspace-down; }
    Mod+K { focus-window-or-workspace-up; }
    Mod+L { focus-column-right; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down-or-to-workspace-down; }
    Mod+Shift+K { move-window-up-or-to-workspace-up; }
    Mod+Shift+L { move-column-right; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+Shift+N { consume-or-expel-window-left; }
    Mod+Shift+M { consume-or-expel-window-right; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { expand-column-to-available-width; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }

    Mod+Shift+C { center-column; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    Mod+Shift+Space { toggle-window-floating; }
    Mod+Space { switch-focus-between-floating-and-tiling; }

    Mod+W { toggle-column-tabbed-display; }

    Mod+S { screenshot; }

    Mod+Escape hotkey-overlay-title="Open Power menu" {
        spawn-sh "./.config/rofi/scripts/pmenu.sh";
    }

    Mod+Shift+Escape allow-inhibiting=false {
      toggle-keyboard-shortcuts-inhibit;
    }

    Mod+F1 { power-off-monitors; }
}
