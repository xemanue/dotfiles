// window-rule {
//     exclude app-id="org.wezfurlong.wezterm"
//     open-maximized true
// }

window-rule {
    match app-id="zen" title="Picture-in-Picture"
    open-floating true
    default-floating-position x=32 y=16 relative-to="bottom-right"
    default-column-width { fixed 480; }
    default-window-height { fixed 270; }
}
