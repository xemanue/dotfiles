@import "../color_scheme.rasi"

* {
    width: 500;
    font: "Iosevkust NFM Regular 13";
}

window {
    width: 362;
    height: 202;
    background-color: @bg;
    border: 1px;
    border-color: @red;
}

mainbox {
    margin: 8px;
    spacing: 8px;
    background-color: inherit;
}

element-text, element-icon {
    background-color: inherit;
    text-color: inherit;
}

inputbar {
    background-color: @float-bg;
    children: [prompt, entry];
}

prompt {
    padding: 8px 15px;
    background-color: @float-bg;
    text-color: @bright;
}

entry {
    padding: 9px 0px;
    text-color: @fg;
    background-color: inherit;
    cursor-width: 10px;
    cursor-color: @red;
    blink: false;
}

listview {
    spacing: 8px;
    columns: 1;
    lines: 5;
    background-color: inherit;
}

element {
    padding: 9px 0px 9px 16px;
    text-color: @dim;
    background-color: @float-bg;
}

element-text {
    highlight: none;
}

element selected {
  color: @red;
}
