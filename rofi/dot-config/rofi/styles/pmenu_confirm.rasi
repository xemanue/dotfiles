@import "../color_scheme.rasi"

* {
    font: "Iosevkust NFM Regular 13";
}

configuration {
    show-icons: false;
}

window {
    width: 184px;
    height: 148px;
    background-color: @bg;
    border: 1px;
    border-color: @red;
}

mainbox {
    margin: 8px;
    spacing: 8px;
    background-color: inherit;
    children: [ "inputbar", "listview" ];
}

inputbar {
    background-color: @float-bg;
    children: [ "textbox-prompt-colon", "prompt"];
}

textbox-prompt-colon {
    expand: false;
    padding: 9px 15px;
    str: "❯";
    background-color: @float-bg;
    text-color: @bright;
}

prompt {
    background-color: inherit;
    vertical-align: 0.5;
    padding: 9px 0px;
    text-color: @fg;
}

listview {
    columns: 2;
    lines: 1;
    cycle: false;
    scrollbar: false;
    spacing: 8px;
    background-color: inherit;
}

element {
    background-color: @float-bg;
    text-color: @dim;
    padding: 18px 0px 19px 0px;
    cursor: pointer;
}

element-text {
    font: "Symbols Nerd Font 32";
    background-color: inherit;
    text-color: inherit;
    cursor: inherit;
    horizontal-align: 0.5;
}

element selected.normal {
    text-color: @red;
}
